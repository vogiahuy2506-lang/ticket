# ---- Database ----------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tickets
# Host port for Postgres (change it if 5432 is already taken on your machine)
DB_PORT=55432
DATABASE_URL=postgres://postgres:postgres@db:5432/tickets

# ---- Host ports --------------------------------------------------------
# API and web ports on the host. Change them if something else is listening.
API_PORT=3101
WEB_PORT=3100

# ---- Public URLs -------------------------------------------------------
# PUBLIC_BASE_URL must be reachable from the internet for the gateway to
# deliver IPN callbacks. Use the tunnel URL (see README), e.g.
# https://xxxx.trycloudflare.com
PUBLIC_BASE_URL=http://localhost:3101
# Public URL of the Next.js app (used for the buyer redirect back from the gateway)
WEB_BASE_URL=http://localhost:3100
# Internal URL of the API, used by the web app (inside docker: http://api:3001)
API_BASE_URL=http://api:3001

# ---- Payment gateway ---------------------------------------------------
# Set MOCK_GATEWAY=true to run with the built-in simulator (no credentials
# needed). Set to false and fill the VNPay sandbox values below to use the
# real sandbox gateway.
MOCK_GATEWAY=true
MOCK_GATEWAY_SECRET=mock-secret-local-dev

# VNPay sandbox credentials - DO NOT COMMIT REAL VALUES.
# Get them from https://sandbox.vnpay.vn (send them to us separately).
VNPAY_URL=https://sandbox.vnpay.vn
VNPAY_MERCHANT_CODE=
VNPAY_SECRET_KEY=

# ---- App ---------------------------------------------------------------
PORT=3001
LOG_LEVEL=info
