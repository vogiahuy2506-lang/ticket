# ---- Database ----------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tickets
# Host port for Postgres (change it if 5432 is already taken on your machine).
DB_PORT=55432
# DATABASE_URL is for processes that run on the HOST (npm run dev, npm run e2e).
# Inside docker compose the API uses the "db" service name instead, because
# that is how containers reach each other - docker-compose.yml sets that
# explicitly, so the two are never mixed up.
DATABASE_URL=postgres://postgres:postgres@localhost:55432/tickets

# ---- Host ports --------------------------------------------------------
# These are the ports on YOUR machine. Docker publishes the containers on
# them; a host-run process listens on them directly. Change them if
# something else is already using the port.
#
# The API container always listens on 3001 internally and is published on
# API_PORT. The web container always listens on 3000 internally and is
# published on WEB_PORT.
API_PORT=3101
WEB_PORT=3000

# ---- Public URLs -------------------------------------------------------
# PUBLIC_BASE_URL must be reachable from the internet for the gateway to
# deliver IPN callbacks. Use the tunnel URL (see README), e.g.
# https://xxxx.trycloudflare.com
PUBLIC_BASE_URL=http://localhost:3101
# Public URL of the Next.js app (used for the buyer redirect back from the
# gateway). Matches WEB_PORT, because `npm run dev` serves the storefront
# on port 3000.
WEB_BASE_URL=http://localhost:3000
# How the storefront reaches the API. On the host that is the published
# port; inside compose the web container uses http://api:3001 instead,
# which docker-compose.yml sets explicitly.
API_BASE_URL=http://localhost:3101

# ---- Payment gateway ---------------------------------------------------
# Set MOCK_GATEWAY=true to run with the built-in simulator (no credentials
# needed). Set to false and fill the VNPay sandbox values below to use the
# real sandbox gateway.
MOCK_GATEWAY=true
MOCK_GATEWAY_SECRET=mock-secret-local-dev

# VNPay sandbox credentials - DO NOT COMMIT REAL VALUES.
# Register at https://sandbox.vnpayment.vn/devreg/ - VNPay emails both values
# (send them to the reviewers separately).
# The payment page the buyer is redirected to. This is the endpoint the
# official VNPay samples use.
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_MERCHANT_CODE=
VNPAY_SECRET_KEY=

# ---- App ---------------------------------------------------------------
# Port the API listens on when it runs on the host. Inside compose the
# container always listens on 3001 and API_PORT is published for it.
PORT=3101
LOG_LEVEL=info
